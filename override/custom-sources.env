# NetForgeCN custom ad sources
# These are the lists that Loyalsoldier/v2ray-rules-dat does NOT include.
# dnsmasq-china-list/accelerated-domains.china.conf is already covered by
# upstream tags china-list / cn, so it is intentionally not duplicated here.
ANTIAD_URL="https://raw.githubusercontent.com/privacy-protection-tools/anti-AD/master/anti-ad-domains.txt"
ADRULES_URL="https://raw.githubusercontent.com/Cats-Team/AdRules/main/mosdns_adrules.txt"
NEODEV_URL="https://raw.githubusercontent.com/neodevpro/neodevhost/master/domain"
